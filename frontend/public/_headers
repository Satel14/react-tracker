# Cloudflare Pages defaults every asset to max-age=14400 + must-revalidate, so
# even content-hashed bundles pay a 304 round trip every few hours.

# Vite fingerprints these filenames, so a changed file is a changed URL.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# NOT immutable: these filenames are stable across deploys (the backend builds
# rank icon paths like /images/ranks/opgg/gold-1.webp), so they get overwritten
# in place. immutable would pin whatever a visitor already cached, forever.
/images/*
  Cache-Control: public, max-age=604800

# Deliberately NOT under /images/ — Pages applies every matching rule and
# comma-joins duplicate headers, so an /images/maps/* rule would collide with
# the /images/* rule above and lose. Versioned in the filename, so pinning is
# safe here.
/map-icons/*
  Cache-Control: public, max-age=31536000, immutable

/map-hi/*
  Cache-Control: public, max-age=31536000, immutable

# The published census, rewritten by the daily job. An hour is long enough to
# absorb whatever traffic a link to it brings and short enough that the file
# somebody cites is the one currently on the page. CORS is open because the
# point of the file is that anyone can read it from anywhere.
/data/*
  Cache-Control: public, max-age=3600
  Access-Control-Allow-Origin: *
